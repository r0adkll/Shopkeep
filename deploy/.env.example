# Shopkeep configuration — copy to .env next to compose.yaml and fill in.
# ────────────────────────────────────────────────────────────────────────
# ⚠ BACK UP THIS FILE ALONGSIDE YOUR DATABASE DUMPS.
#   TOKEN_ENCRYPTION_KEY encrypts storefront OAuth tokens at rest; a database
#   restored without the original key loses all storefront connections
#   (Shopkeep degrades gracefully and prompts re-auth, but save yourself the trip).

# --- required ---
POSTGRES_PASSWORD=
SESSION_SECRET=            # random 64+ chars: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=      # random 64 hex chars: openssl rand -hex 32

# --- optional ---
SHOPKEEP_PORT=8080
POSTGRES_DB=shopkeep
POSTGRES_USER=shopkeep

# OIDC single sign-on (leave blank to disable; local login always works)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Storefront sync + queue behavior
SYNC_INTERVAL_MINUTES=5
# Opening the orders screen triggers a sync, at most once per this window
VIEW_SYNC_COOLDOWN_SECONDS=60
ORDER_ARCHIVE_DAYS=30

# Backup profile
BACKUP_DIR=./backups
